{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main",
    "tab_*",
    "jl_mode",
    "jl_lookup",
    "lookup_*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-set-always-on-top",
    "window-state:default",
    "process:default",
    "updater:default",
    "http:default",
    "fs:default"
  ]
}
